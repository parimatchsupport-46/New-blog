rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Complains collection - Firestore Only (No Storage)
    // All 5 complain pages save docs here with base64 images in 'files' field
    match /complains/{docId} {
      allow create: if true;
      allow read: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}
