rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Complains collection - allow anyone to create/read, restrict update/delete
    match /complains/{docId} {
      allow create: if true;
      allow read: if true;
      allow update: if false;
      allow delete: if false;
    }
    
    // Optional: allow admin to manage if needed in future
    // match /complains/{docId} {
    //   allow read, write: if request.auth != null;
    // }
  }
}
